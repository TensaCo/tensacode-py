{
  "version": 1,
  "recipes": [{
    "id": "minimal-python-project",
    "description": "Hand-authored convention: an unspecified Python project is a directory containing a hello-world main.py; this is not inferred or learned.",
    "match": {"predicate": "be", "role": "undergoer", "features": {"noun": "project", "quality": "python"}},
    "accepted_features": ["definite"],
    "modifier_aliases": {"compound": "quality", "amod": "quality", "name": "name", "location": "location"},
    "implicit_lexical_conditions": [
      {"predicate": "made_of", "roles": {"Product": "matched", "Material": "unbound"}},
      {"predicate": "be", "roles": {"Precondition": "implicit_addressee"}}
    ],
    "bindings": {
      "root": {"from": "context.root"},
      "location": {"from": "entity.location", "fallbacks": ["frame.roles.location"], "default": ".", "extraction": "text", "accepted_features": ["noun", "number", "definite"]},
      "name": {"from": "entity.name", "default": "hello-world", "extraction": "text", "accepted_features": ["noun", "number", "definite"]}
    },
    "derived": {
      "directory": {"path": [{"binding": "root"}, {"binding": "location"}, {"binding": "name"}]},
      "entrypoint": {"path": [{"binding": "directory"}, "main.py"]}
    },
    "outputs": [
      {"predicate": "directory_exists", "roles": {"path": {"binding": "directory"}}},
      {"predicate": "file_exists", "roles": {"path": {"binding": "entrypoint"}}},
      {"predicate": "content", "roles": {"path": {"binding": "entrypoint"}, "text": "print(\"Hello, world!\")\n"}}
    ]
  }]
}

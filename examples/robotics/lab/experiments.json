{
  "schema_version": 1,
  "experiments": [
    {
      "id": "guarded-planning",
      "title": "Contact-guided reach",
      "status": "pass",
      "evidence": "planning/results.json",
      "summary": "planned-height-v1 development replay, raised pedestal (+4 cm). Left: sensor-anchored geometry, bounded IK and contact guards. Right: previous ALG.2 retargeting failure. Later regression outcomes below use a revised controller; this video shows v1. Known-shape local clearance, not global warehouse planning.",
      "graph_label": "CONTROLLER GRAPH \u00b7 LEFT POLICY",
      "graph": {
        "blocks": {
          "cam": {
            "col": 0,
            "row": 0,
            "kind": "o",
            "title": "RGB-D camera",
            "ins": ["scene"],
            "outs": ["rgb", "depth"],
            "description": "Calibrated RGB-D workcell camera; warehouse decoration is not part of these sensor frames."
          },
          "prop": {
            "col": 0,
            "row": 2,
            "kind": "o",
            "title": "Proprioception",
            "ins": ["body"],
            "outs": ["imu", "q", "contact", "pad force"],
            "description": "Joint encoders, IMU, foot contacts and gripper pad force measurements. No object or root world pose."
          },
          "det": {
            "col": 1,
            "row": 0,
            "kind": "a",
            "title": "Visual detection",
            "ins": ["rgb", "depth"],
            "outs": ["object xyz", "root xyz"],
            "description": "Authored color segmentation and calibrated backprojection for orange SKU and pelvis marker."
          },
          "est": {
            "col": 1,
            "row": 2,
            "kind": "a",
            "title": "Robot belief",
            "ins": ["imu", "q", "contact", "root xyz"],
            "outs": ["state"],
            "description": "Root estimate combines RGB-D marker, IMU, encoders and contact-based odometry."
          },
          "bel": {
            "col": 2,
            "row": 0,
            "kind": "a",
            "title": "Object belief",
            "ins": ["object xyz"],
            "outs": ["anchor"],
            "description": "Innovation-gated Gaussian object-position estimate. Upright 5 cm cube and square support geometry are supplied priors, positioned by the visual estimate."
          },
          "plan": {
            "col": 3,
            "row": 0,
            "kind": "a",
            "title": "Geometric targets",
            "ins": ["anchor"],
            "outs": ["waypoints"],
            "description": "Sensor-anchored approach, alignment, descent, lift and retract waypoints; target speed limited to 4 cm/s. Not a global collision-free planner."
          },
          "guard": {
            "col": 3,
            "row": 2,
            "kind": "a",
            "title": "Contact guards",
            "ins": ["waypoints", "state", "pad force"],
            "outs": ["target", "contact mode", "grip"],
            "description": "Tracking and orientation checks gate target progress; bilateral pad contacts gate grasp/lift, with timeout/abort transitions. Authored feedback state machine, not demonstration ICL."
          },
          "ik": {
            "col": 4,
            "row": 0,
            "kind": "a",
            "title": "Bounded arm IK",
            "ins": ["target", "state", "contact mode"],
            "outs": ["q* arm"],
            "description": "This recorded episode uses SciPy bounded damped least squares, joint/step limits, and sampled tool/support clearance. Optional compiled ALG.0/1/2 QP iterations and checked SciPy fallback are evaluated separately in results.json."
          },
          "walk": {
            "col": 4,
            "row": 2,
            "kind": "f",
            "title": "Frozen RL walker",
            "ins": ["goal", "state"],
            "outs": ["q* legs"],
            "description": "Frozen Unitree locomotion model shared with the earlier retargeting controller."
          },
          "servo": {
            "col": 5,
            "row": 0,
            "kind": "x",
            "title": "Joint servo",
            "ins": ["q* arm", "q* legs", "grip"],
            "outs": ["torque"],
            "description": "Arm and leg joint targets, gripper command and estimated gravity compensation drive joint servos."
          },
          "robot": {
            "col": 6,
            "row": 0,
            "kind": "x",
            "title": "G1 robot (sim)",
            "ins": ["torque"],
            "outs": ["scene", "body"],
            "description": "MuJoCo G1 physics. Recorded truth is used for scoring and diagnosis only."
          }
        },
        "wires": [
          ["cam.rgb", "det.rgb"],
          ["cam.depth", "det.depth"],
          ["det.object xyz", "bel.object xyz"],
          ["det.root xyz", "est.root xyz"],
          ["prop.imu", "est.imu"],
          ["prop.q", "est.q"],
          ["prop.contact", "est.contact"],
          ["bel.anchor", "plan.anchor"],
          ["bel.anchor", "walk.goal"],
          ["plan.waypoints", "guard.waypoints"],
          ["prop.pad force", "guard.pad force"],
          ["est.state", "guard.state"],
          ["est.state", "ik.state"],
          ["est.state", "walk.state"],
          ["guard.target", "ik.target"],
          ["guard.contact mode", "ik.contact mode"],
          ["guard.grip", "servo.grip"],
          ["ik.q* arm", "servo.q* arm"],
          ["walk.q* legs", "servo.q* legs"],
          ["servo.torque", "robot.torque"],
          ["robot.scene", "cam.scene"],
          ["robot.body", "prop.body"]
        ]
      },
      "episodes": [
        {
          "id": "height-development",
          "title": "planned-height-v1 \u00b7 development replay (+4 cm)",
          "video": "planning/height-comparison.mp4",
          "poster": "planning/poster.png",
          "traces": [
            {
              "path": "planning/runs/development-height-v1/records.json.gz",
              "label": "Guarded controller (left)",
              "block": "guard"
            },
            {
              "path": "transfer/runs/height-context/records.json.gz",
              "label": "Retargeting (right)",
              "block": "guard"
            }
          ]
        }
      ],
      "outcomes_source": "planning/results.json",
      "outcome_collections": ["runs"]
    },
